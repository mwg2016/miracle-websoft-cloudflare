{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "miracle-websoft-cloudflare",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Customer reviews (submit → admin approval → public). The only persisted
	// data on the site; leads are still email-only. Create once with
	//   npx wrangler d1 create mw-reviews
	// and paste the returned database_id below, then apply the schema with
	//   npx wrangler d1 migrations apply mw-reviews --remote
	"d1_databases": [
		{
			"binding": "REVIEWS_DB",
			"database_name": "mw-reviews",
			"database_id": "REPLACE_WITH_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	]
}
