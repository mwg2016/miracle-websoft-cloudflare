{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "miracle-websoft-cloudflare",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Run `npx wrangler kv namespace create LEADS_KV` and paste the returned id here.
	"kv_namespaces": [
		{
			"binding": "LEADS_KV",
			"id": "6203b2353d324ca39aa36e38e7c4311d",
			"remote": true
		}
	]
}