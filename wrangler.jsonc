{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miracle-websoft-cloudflare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Run `npx wrangler kv namespace create LEADS_KV` and paste the returned id here.
  "kv_namespaces": [
    { "binding": "LEADS_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // Run `npx wrangler r2 bucket create miracle-websoft-resumes` first.
  "r2_buckets": [
    { "binding": "RESUMES_R2", "bucket_name": "miracle-websoft-resumes" }
  ]
}
