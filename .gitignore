node_modules/
.next/

# Build artifacts — regenerated on every build, so they must not be tracked.
# When tracked, each deploy's `git pull` aborts because the freshly built
# copy differs from the committed one (the Next.js default ignores these too).
next-env.d.ts
*.tsbuildinfo

.env
.env.local
.env*.local
*.log
pm2-error.log
pm2-out.log

# Admin / runtime data — never commit lead records or uploaded resumes.
# The data/ folder itself is kept via .gitkeep.
data/*
!data/.gitkeep
